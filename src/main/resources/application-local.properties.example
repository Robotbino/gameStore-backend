# ============================================================
# Template. Copy to application-local.properties and fill in.
#
#   cp application-local.properties.example application-local.properties
#
# The real file is gitignored. This template is committed so a
# fresh clone knows what it needs to run.
# ============================================================

# Base64, >= 256 bits. Generate your own:  openssl rand -base64 32
# Never reuse a value that has appeared in a repo, a chat, or a ticket.
JWT_SECRET=

# Local MySQL password for the user in spring.datasource.username.
DB_PASSWORD=

# Optional overrides — sensible defaults live in application.properties.
# DB_URL=jdbc:mysql://localhost:3306/gamestore_db
# DB_USERNAME=root
# SERVER_PORT=8181
# ADMIN_EMAIL=admin@gamestore.com
# CORS_ALLOWED_ORIGINS=http://localhost:5173
# RAWG_API_KEY=
